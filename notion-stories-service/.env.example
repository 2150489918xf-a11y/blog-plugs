# Required for querying the Notion database list.
NOTION_TOKEN=secret_xxx
NOTION_DATABASE_ID=37bbedc8681180199bbce653a8bf2325

# Public site config.
SITE_URL=https://stories.xiongfan.me
SITE_TITLE=图片故事
SITE_DESCRIPTION=用 Notion 记录生活、照片和回忆。
HALO_SITE_URL=https://xiongfan.me
CACHE_TTL_SECONDS=600

# Notion database property mappings.
NOTION_TITLE_PROPERTY=标题
NOTION_SLUG_PROPERTY=Slug
NOTION_DATE_PROPERTY=日期
NOTION_PUBLISHED_PROPERTY=状态
NOTION_PUBLISHED_PROPERTY_TYPE=checkbox
NOTION_PUBLISHED_VALUE=公开
NOTION_SUMMARY_PROPERTY=摘要
NOTION_TAGS_PROPERTY=标签
NOTION_COVER_PROPERTY=封面图

# react-notion-x renders public Notion pages best.
# Leave these empty for public pages. Only use them if you understand Notion session risk.
NOTION_X_AUTH_TOKEN=
NOTION_X_ACTIVE_USER=
